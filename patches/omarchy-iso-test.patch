+        tar -C "$host_home/.config" \
+          --exclude='hypr/monitors.conf' --exclude='hypr/monitors.lua' \
+          -cf - "$config_dir" \
+          | ssh_guest "mkdir -p .config && tar -C .config -xf -" || return $?
