+      background=$(readlink -f -- "$selected_background") || {
+        log "ERROR: Cannot resolve host background '$selected_background'" >&2
+        return 1
+      }
+      if [[ ! -f $background || ! -r $background ]]; then
+        log "ERROR: Host background '$selected_background' must resolve to a readable regular file" >&2
+        return 1
