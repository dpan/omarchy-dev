#!/bin/bash
# Manage the shared base image (ISO → base.qcow2 for stock + all worktrees).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= builtin cd -- "$(dirname "$0")" && builtin pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

usage() {
  cat <<'EOF'
Usage: omarchy-dev-rebase [list|status|<target>]

  (no args)  Interactive pick (gum) from available ISOs, then rebuild base
  list       Print available ISOs — no rebuild
  status     Show which ISO / base image is active
  <target>   Rebuild base from that ISO:
               edge | stable | rc     channel shortcut (rc = newest rc)
               <version>              e.g. 4.0.6, 4.5.0rc1, 2026.10.26.466
               <iso-name> | <path>    as shown by list

  One base image is shared by stock testing and every worktree.

Examples:
  mise rebase list
  mise rebase
  mise rebase status
  mise rebase edge
  mise rebase stable
  mise rebase rc
  mise rebase 4.5.0rc1
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  list)
    omarchy_dev_rebase_list
    ;;
  status)
    omarchy_dev_rebase_status
    ;;
  "")
    omarchy_dev_rebase
    ;;
  *)
    omarchy_dev_rebase "$1"
    ;;
esac
