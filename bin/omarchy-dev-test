#!/bin/bash
# Boot the shared base image for interactive use (default), or run
# automated checks with --run-tests.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= builtin cd -- "$(dirname "$0")" && builtin pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

usage() {
  cat <<'EOF'
Usage: omarchy-dev-test [session-flags] [--run-tests] [--host-config] [tree] [-- iso-test-args...]

  Boot the current base image (see: mise rebase status) in a QEMU
  window so you can use the desktop. Leaves the VM running.

  No tree → stock installed Omarchy.
  With tree → that worktree becomes the live Omarchy in the guest
  (menu, bin/, defaults).

  --run-tests     Also run automated checks, then stop the VM
                  (pass --keep-running after -- if you want it left up).
  --host-config   Copy selected host ~/.config dirs into this throwaway guest
                  (interactive only; ignored with --run-tests).
                  Override dirs: OMARCHY_DEV_HOST_CONFIG_DIRS
                  (default: omarchy hypr alacritty ghostty kitty foot walker).
                  hypr monitors.conf / monitors.lua are skipped.

  Default session: QEMU window + keyboard grab.

EOF
  omarchy_dev_session_flags_help
  cat <<'EOF'

Examples:
  mise test
  mise test my-feature-worktree
  mise test --host-config
  mise test --host-config my-feature-worktree
  mise test --run-tests my-feature-worktree
  mise test --ssh --no-grab-kbd my-feature-worktree
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac

omarchy_dev_session_parse_flags "$@"
set -- "${OMARCHY_DEV_SESSION_REST[@]}"

tree_arg=
run_tests=false
host_config=false
extra=()

while (($#)); do
  case "$1" in
    --run-tests)
      run_tests=true
      shift
      ;;
    --host-config)
      host_config=true
      shift
      ;;
    --)
      shift
      extra+=("$@")
      set --
      ;;
    -*)
      extra+=("$@")
      break
      ;;
    *)
      [[ -z $tree_arg ]] || omarchy_dev_die "Unexpected tree argument: $1 (put harness arguments after --)"
      tree_arg=$1
      shift
      ;;
  esac
done

tree=
[[ -z $tree_arg ]] || tree=$(omarchy_dev_resolve_tree "$tree_arg")

omarchy_dev_require_iso_repo
omarchy_dev_ensure_iso_harness_patch

iso=$(omarchy_dev_require_base)
omarchy_dev_rebase_status >&2
omarchy_dev_session_prepare "omarchy-dev-test"

builtin cd "$OMARCHY_DEV_ISO"

iso_args=("$iso" --reuse-base --no-preview)
if $run_tests; then
  echo "Mode: run-tests (automated checks, then stop unless --keep-running)"
  unset OMARCHY_ISO_SKIP_TESTS || true
  if $host_config; then
    echo "Note: --host-config ignored with --run-tests (keep checks deterministic)" >&2
    host_config=false
  fi
else
  echo "Mode: interactive desktop (VM left running; pass --run-tests for automated checks)"
  export OMARCHY_ISO_SKIP_TESTS=1
  iso_args+=(--keep-running)
fi

if $host_config; then
  export OMARCHY_DEV_SYNC_HOST_CONFIG=1
  export OMARCHY_DEV_HOST_HOME="${OMARCHY_DEV_HOST_HOME:-$HOME}"
  echo "Host config: sync allowlist from $OMARCHY_DEV_HOST_HOME/.config (this run only)"
else
  unset OMARCHY_DEV_SYNC_HOST_CONFIG || true
fi

if [[ -z $tree_arg ]]; then
  echo "Tree: stock base (no worktree sync)"
  echo "Using ISO: $iso"
  ./bin/omarchy-iso-test "${iso_args[@]}" "${extra[@]}"
else
  echo "Tree: $tree (live Omarchy in guest)"
  echo "Using ISO: $iso"
  echo "Materializing a standalone Git checkout for guest sync"
  sync_tree=$(omarchy_dev_materialize_sync_tree "$tree")
  OMARCHY_DEV_SESSION_SYNC_TREE=$sync_tree
  export OMARCHY_PATH=$sync_tree
  export OMARCHY_ISO_ACTIVATE_SYNC=1
  ./bin/omarchy-iso-test "${iso_args[@]}" --sync-all "$sync_tree" "${extra[@]}"
fi
