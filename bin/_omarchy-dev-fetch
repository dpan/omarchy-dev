#!/bin/bash
# Internal: dirs, omarchy-iso clone, optional ISO download. Called by setup.
set -euo pipefail

SCRIPT_DIR="$(CDPATH= builtin cd -- "$(dirname "$0")" && builtin pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

FETCH_ISO=false
CHANNEL=edge
ISO_REMOTE="${ISO_REMOTE:-https://github.com/omacom/omarchy-iso.git}"

usage() {
  cat <<'EOF'
Usage: _omarchy-dev-fetch [--iso] [--channel edge|stable]

  Internal helper (prefer: mise setup).
EOF
}

while (($#)); do
  case "$1" in
    --iso) FETCH_ISO=true ;;
    --channel)
      CHANNEL=$2
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
  shift
done

mkdir -p "$OMARCHY_DEV_WORKTREES" "$OMARCHY_DEV_VMS"

if [[ -L $OMARCHY_DEV_OMARCHY ]]; then
  omarchy_dev_die "$OMARCHY_DEV_OMARCHY is a symlink; use a real clone inside omarchy-dev"
fi
if [[ ! -d $OMARCHY_DEV_OMARCHY/.git && ! -f $OMARCHY_DEV_OMARCHY/.git ]]; then
  omarchy_dev_die "Missing omarchy git checkout at $OMARCHY_DEV_OMARCHY — run: mise setup"
fi

if [[ ! -d $OMARCHY_DEV_ISO/.git ]]; then
  if [[ -e $OMARCHY_DEV_ISO ]]; then
    omarchy_dev_die "$OMARCHY_DEV_ISO exists but is not a git checkout — remove it and re-run"
  fi
  echo "Cloning omarchy-iso → $OMARCHY_DEV_ISO"
  git clone "$ISO_REMOTE" "$OMARCHY_DEV_ISO"
fi
mkdir -p "$OMARCHY_DEV_ISO/release"
omarchy_dev_ensure_iso_qemu_extra_hook

if command -v mise >/dev/null 2>&1 && [[ -f $OMARCHY_DEV_ROOT/mise.toml ]]; then
  if ! mise -C "$OMARCHY_DEV_ROOT" bootstrap packages status --missing >/dev/null 2>&1; then
    echo "Host packages out of sync with mise.toml — run:"
    echo "  mise -C $OMARCHY_DEV_ROOT bootstrap packages apply"
  fi
else
  missing=()
  for cmd in qemu-system-x86_64 jq curl; do
    command -v "$cmd" >/dev/null 2>&1 || missing+=("$cmd")
  done
  [[ -e /usr/share/edk2/x64/OVMF_CODE.4m.fd || -e /usr/share/edk2-ovmf/x64/OVMF_CODE.4m.fd ]] ||
    missing+=("edk2-ovmf")
  if ((${#missing[@]})); then
    echo "Missing tools/firmware: ${missing[*]}"
    echo "Prefer: mise bootstrap packages apply (from omarchy-dev with mise.toml)"
  fi
fi

if $FETCH_ISO; then
  command -v jq >/dev/null || omarchy_dev_die "jq is required to read latest.json"
  command -v curl >/dev/null || omarchy_dev_die "curl is required to download artifacts"
  meta=$(curl -fsSL "$(omarchy_dev_channel_url "$CHANNEL")")
  version=$(jq -r .version <<<"$meta")
  echo "Channel $CHANNEL version $version"
  iso_url=$(jq -r .url <<<"$meta")
  iso_name=${iso_url##*/}
  omarchy_dev_fetch_file "$iso_url" "$OMARCHY_DEV_ISO/release/$iso_name" "$iso_url.sha256"
fi
